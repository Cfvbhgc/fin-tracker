<UserControl x:Class="FinTracker.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:FinTracker.ViewModels">

    <UserControl.DataContext>
        <viewmodels:BudgetViewModel />
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Add new budget form -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Create New Budget"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Category" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding NewBudgetCategory}"
                                      DisplayMemberPath="Name"
                                      Width="180"
                                      Padding="8,6" FontSize="13" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Monthly Limit ($)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewBudgetMonthlyLimit, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140"
                                     Padding="8,6" FontSize="13" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Month" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding SelectedBudgetMonth}"
                                        Width="140"
                                        Padding="4,4" FontSize="13" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddBudgetCommand}"
                                    Content="Add Budget" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Budget list with progress bars -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Monthly Budgets"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding RefreshBudgetsCommand}"
                                    Content="Refresh"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteBudgetCommand}"
                                    Content="Delete Selected" />
                        </StackPanel>
                    </DockPanel>

                    <ListView ItemsSource="{Binding BudgetDisplayItems}"
                              SelectedItem="{Binding SelectedBudgetItem}"
                              BorderThickness="0"
                              Background="Transparent"
                              MaxHeight="500">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,8" CornerRadius="8"
                                        BorderBrush="#E2E8F0" BorderThickness="1"
                                        Background="#FAFBFC" Width="700">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="6" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Category name and month -->
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1E293B"
                                                       DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding Budget.Month, StringFormat='{}{0:MMMM yyyy}'}"
                                                       FontSize="12"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Right" />
                                        </DockPanel>

                                        <!-- Progress bar showing budget usage -->
                                        <ProgressBar Grid.Row="2"
                                                     Value="{Binding UsagePercentage}"
                                                     Maximum="100"
                                                     Height="12"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Background="#E2E8F0" />

                                        <!-- Spending details -->
                                        <DockPanel Grid.Row="4">
                                            <TextBlock DockPanel.Dock="Left"
                                                       FontSize="12"
                                                       Foreground="#64748B">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="${0:N2} of ${1:N2}">
                                                        <Binding Path="AmountSpent" />
                                                        <Binding Path="Budget.MonthlyLimit" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{Binding RemainingText}"
                                                       FontSize="12"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state message shown when no budgets exist -->
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
