<UserControl x:Class="FinTracker.Views.TransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:FinTracker.ViewModels"
             xmlns:converters="clr-namespace:FinTracker.Converters">

    <UserControl.DataContext>
        <viewmodels:TransactionViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Summary cards showing total income and expense -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Income Card -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Income"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding TotalIncome, StringFormat='${0:N2}'}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Total Expense Card -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Expenses"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding TotalExpense, StringFormat='${0:N2}'}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Net Balance Card -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Net Balance"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" />
                        <TextBlock Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="${0:N2}">
                                    <Binding Path="TotalIncome" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Add new transaction form -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Add New Transaction"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Description field -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="Description" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewTransactionDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13" />
                        </StackPanel>

                        <!-- Amount field -->
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="Amount ($)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewTransactionAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13" />
                        </StackPanel>

                        <!-- Category selector -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Category" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="Name"
                                      Padding="8,6" FontSize="13" />
                        </StackPanel>

                        <!-- Date picker -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Date" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding NewTransactionDate}"
                                        Padding="4,4" FontSize="13" />
                        </StackPanel>

                        <!-- Transaction type selector -->
                        <StackPanel Grid.Row="2" Grid.Column="4">
                            <TextBlock Text="Type" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding TransactionTypes}"
                                      SelectedItem="{Binding SelectedTransactionType}"
                                      Padding="8,6" FontSize="13" />
                        </StackPanel>

                        <!-- Add button -->
                        <Button Grid.Row="4" Grid.Column="4"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddTransactionCommand}"
                                Content="Add Transaction" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Filter controls -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Filter Transactions"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="From" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding FilterStartDate}" Width="140" Padding="4,4" FontSize="13" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="To" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding FilterEndDate}" Width="140" Padding="4,4" FontSize="13" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Category" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding FilterCategory}"
                                      DisplayMemberPath="Name"
                                      Width="150"
                                      Padding="8,6" FontSize="13" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ApplyFilterCommand}"
                                    Content="Apply Filter"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ClearFilterCommand}"
                                    Content="Clear"
                                    Background="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Transactions data grid -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Transaction History"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ExportToCsvCommand}"
                                    Content="Export CSV"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteTransactionCommand}"
                                    Content="Delete Selected" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding Transactions}"
                              SelectedItem="{Binding SelectedTransaction}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeight="40"
                              MaxHeight="400"
                              FontSize="13"
                              Background="Transparent"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                Width="100" />
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                Width="*" />
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category.Name}"
                                                Width="120" />
                            <DataGridTextColumn Header="Amount"
                                                Binding="{Binding Amount, StringFormat='${0:N2}'}"
                                                Width="100" />
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding Type}"
                                                Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
